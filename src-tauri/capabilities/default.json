{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "MT Manager default capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "shell:allow-open",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-read-dir",
    "fs:allow-create-dir",
    "fs:allow-remove-dir",
    "fs:allow-remove-file",
    "fs:allow-rename",
    "fs:allow-exists",
    "fs:allow-stat",
    "opener:allow-open-path",
    "opener:allow-open-url"
  ]
}
